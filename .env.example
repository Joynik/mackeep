# Copy this example to .env and edit the settings you need.
# Remove optional overrides to use the defaults in mise.toml.
# Keep real secrets in .env.

# Python project paths
PROJECT_ROOT="."

# Python source
PYTHON_SOURCE="."

# Swift
SWIFT_BACKEND="swiftpm"
PROJECT_SWIFT_DIRECTORY="."
XCODE_PROJECT=
XCODE_SCHEME=
XCODE_DESTINATION="platform=macOS"

# Python tests
PYTHON_TESTS="tests"

# Nuitka build
PYTHON_ENTRYPOINT="main.py"
PYTHON_BUILD_DIRECTORY="dist"
