{
  "schema_version": 2,
  "version": "0.15.1",
  "config_file": "/Users/user/.mackeep.cfg",
  "custom_apps_dir": "/Users/user/.mackeep",
  "custom_apps_dirs": [
    "/Users/user/.mackeep",
    "/Users/user/.config/mackeep/applications"
  ],
  "storage": {
    "engine": "file_system",
    "path": "/Users/user/dotfiles",
    "directory": "Mackeep",
    "resolved_backup_dir": "/Users/user/dotfiles/Mackeep",
    "exists": true
  },
  "apps_to_sync": ["vim"],
  "apps_to_ignore": [],
  "global_exclude": ["**/.DS_Store"],
  "global_xdg_exclude": []
}
