{
  "schema_version": 1,
  "version": "0.15.1",
  "config_file": "/Users/user/.mackeep.cfg",
  "config_file_is_legacy": false,
  "custom_apps_dirs": [
    "/Users/user/.mackeep",
    "/Users/user/.config/mackeep/applications"
  ],
  "legacy_custom_apps_dirs": [
    "/Users/user/.mackup",
    "/Users/user/.config/mackup/applications"
  ],
  "storage": {
    "engine": "file_system",
    "path": "/Users/user/dotfiles",
    "directory": "Mackeep",
    "resolved_backup_dir": "/Users/user/dotfiles/Mackeep",
    "exists": true,
    "using_legacy_directory": false
  },
  "apps_to_sync": ["vim"],
  "apps_to_ignore": [],
  "global_exclude": ["**/.DS_Store"],
  "global_xdg_exclude": []
}
