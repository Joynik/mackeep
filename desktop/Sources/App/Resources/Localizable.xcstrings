    "backup.restore.changed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration oder Wiederherstellungsplan haben sich geändert. Prüfe die aktualisierte Vorschau und bestätige erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration or restore plan changed. Review the updated preview and confirm again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración o el plan de restauración cambió. Revisa la vista previa actualizada y confirma de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration ou le plan de restauration a changé. Vérifiez l’aperçu actualisé et confirmez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione o il piano di ripristino è cambiato. Controlla l’anteprima aggiornata e conferma di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定または復元プランが変更されました。更新されたプレビューを確認し、もう一度確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 또는 복원 계획이 변경되었습니다. 업데이트된 미리보기를 검토하고 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração ou o plano de restauração mudou. Revise a prévia atualizada e confirme novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки или план восстановления изменились. Проверьте обновлённый предпросмотр и подтвердите ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування або план відновлення змінилися. Перевірте оновлений попередній перегляд і підтвердьте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置或恢复计划已更改。请检查更新后的预览并再次确认。"
          }
        }
      }
    },
