    "settings.security.externalPaths": {
      "comment": "The string of the interface",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfade außerhalb des Benutzerordners erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow paths outside the home folder"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir rutas fuera de la carpeta de inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les chemins hors du dossier personnel"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti percorsi fuori dalla cartella Inizio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームフォルダ外のパスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 폴더 외부 경로 허용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir caminhos fora da pasta pessoal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешать пути вне домашней папки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяти шляхи поза домашньою текою"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许主文件夹之外的路径"
          }
        }
      }
    },
    "settings.security.externalPaths.help": {
      "comment": "The string of the interface",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig deaktiviert. Externe Dateien werden separat gesichert und unter ihren konfigurierten absoluten Pfaden wiederhergestellt. Erfordert eine kompatible CLI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. External files are stored separately in the backup and restored to their configured absolute paths. Requires a compatible CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. Los archivos externos se guardan por separado y se restauran en sus rutas absolutas configuradas. Requiere una CLI compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Les fichiers externes sont sauvegardés séparément et restaurés à leurs chemins absolus configurés. Nécessite une CLI compatible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato per impostazione predefinita. I file esterni vengono salvati separatamente e ripristinati nei percorsi assoluti configurati. Richiede una CLI compatibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定では無効です。外部ファイルはバックアップ内に個別に保存され、設定した絶対パスに復元されます。対応するCLIが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 외부 파일은 별도로 백업되며 설정된 절대 경로로 복원됩니다. 호환되는 CLI가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado por padrão. Arquivos externos são salvos separadamente e restaurados nos caminhos absolutos configurados. Requer uma CLI compatível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Внешние файлы хранятся отдельно в бэкапе и восстанавливаются по настроенным абсолютным путям. Требуется совместимая версия CLI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово вимкнено. Зовнішні файли зберігаються окремо в резервній копії та відновлюються за налаштованими абсолютними шляхами. Потрібна сумісна версія CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。外部文件单独备份，并恢复到配置的绝对路径。需要兼容的 CLI。"
          }
        }
      }
    },
