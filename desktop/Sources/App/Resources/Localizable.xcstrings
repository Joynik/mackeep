    "onboarding.tool.help": {
      "comment": "The string of the settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die Terminalversion von Mackeep mit Homebrew und starte die Anwendung neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the terminal version of Mackeep with Homebrew, then start the application again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la versión de terminal de Mackeep con Homebrew y vuelve a iniciar la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez la version de terminal de Mackeep avec Homebrew, puis relancez l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa la versione da terminale di Mackeep con Homebrew, poi riavvia l'applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew で Mackeep のターミナル版をインストールしてから、アプリを起動し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew로 Mackeep의 터미널 버전을 설치한 다음 앱을 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale a versão de terminal do Mackeep com Homebrew e inicie o aplicativo de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите терминальную версию Mackeep через Homebrew и запустите приложение снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть термінальну версію Mackeep через Homebrew і запустіть застосунок знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Homebrew 安装 Mackeep 的终端版，然后重新启动应用。"
          }
        }
      }
    },
