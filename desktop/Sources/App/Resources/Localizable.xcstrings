    "applications.library.removeExplanation": {
      "comment": "The string of the interface",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die MacKeep-Definition und ihre Auswahl werden entfernt. Die Anwendung, ihre Einstellungen und Sicherungen bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the MacKeep definition and its selection are removed. The application, its settings and backups are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminan la definición de MacKeep y su selección. La aplicación, sus ajustes y copias de seguridad se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules la définition MacKeep et sa sélection sont supprimées. L’application, ses réglages et les sauvegardes sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono rimosse solo la definizione MacKeep e la sua selezione. L’applicazione, le sue impostazioni e i backup vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacKeepの定義とバックアップ対象の選択のみを削除します。アプリケーション、設定、バックアップは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MacKeep 정의와 백업 대상 선택만 제거됩니다. 앱, 설정 및 백업은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a definição do MacKeep e sua seleção são removidas. O aplicativo, suas configurações e os backups são preservados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалятся только определение MacKeep и его выбор для копирования. Программа, её настройки и резервные копии сохранятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде видалено лише визначення MacKeep і його вибір для копіювання. Програма, її налаштування та резервні копії залишаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除 MacKeep 定义及其备份选择。应用程序、设置和备份将保留。"
          }
        }
      }
    },
