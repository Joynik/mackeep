        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このCLIはアプリと互換性がありません。アプリと同じバージョンのCLIを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI가 이 앱과 호환되지 않습니다. 앱과 같은 버전의 CLI를 다시 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A CLI é incompatível com este aplicativo. Reinstale a CLI com a mesma versão do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI несовместим с приложением. Переустановите CLI той же версии, что и приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI несумісний із програмою. Перевстановіть CLI тієї самої версії, що й програма."
