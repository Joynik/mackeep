            "state": "translated",
            "value": "Solo se muestra parte de la tabla. Los totales incluyen toda la ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une partie du tableau est affichée. Les totaux couvrent toute l’exécution."
