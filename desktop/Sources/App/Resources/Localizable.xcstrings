    "settings.tool.incompatible": {
      "comment": "The string of the interface",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die CLI ist mit dieser App nicht kompatibel. Installieren Sie die CLI in derselben Version wie die Desktop-App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The CLI is incompatible with this application. Reinstall the CLI with the same version as the desktop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI no es compatible con esta aplicación. Reinstala la CLI con la misma versión que la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI est incompatible avec cette application. Réinstallez la CLI avec la même version que l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI non è compatibile con questa app. Reinstalla la CLI con la stessa versione dell’app."
