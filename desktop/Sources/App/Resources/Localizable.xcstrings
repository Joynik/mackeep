          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표의 일부만 표시됩니다. 합계에는 전체 실행이 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas parte da tabela é exibida. Os totais incluem toda a execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показана только часть строк. Итоговые счётчики учитывают весь запуск."
