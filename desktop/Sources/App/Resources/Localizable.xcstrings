    "settings.tool.oldVersion.help": {
      "comment": "The string of the settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung braucht die Version 0.13.0 von Mackeep, mit den Ausschlussregeln und der JSON-Schnittstelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup needs the version 0.13.0 of Mackeep, with the exclusion rules and the JSON interface."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad necesita la versión 0.13.0 de Mackeep, con las reglas de exclusión y la interfaz JSON."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde a besoin de la version 0.13.0 de Mackeep, avec les règles d'exclusion et l'interface JSON."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio richiede la versione 0.13.0 di Mackeep, con le regole di esclusione e l'interfaccia JSON."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには、除外ルールと JSON インターフェースを備えた Mackeep 0.13.0 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에는 제외 규칙과 JSON 인터페이스가 있는 Mackeep 0.13.0 이상이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup precisa da versão 0.13.0 do Mackeep, com as regras de exclusão e a interface JSON."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для бэкапа нужна версия Mackeep 0.13.0 и новее — с правилами исключения и JSON-интерфейсом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для бекапу потрібна версія Mackeep 0.13.0 або новіша — з правилами виключення та JSON-інтерфейсом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份需要 Mackeep 0.13.0 或更高版本，其中包含排除规则和 JSON 接口。"
          }
        }
      }
    },
