    "backup.advanced.explanation": {
      "comment": "The string of the backup section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verknüpfungsmodi sind verborgen: ab macOS 14 zerstören die Verknüpfungen auf die Einstellungsdateien die Einstellungen der Anwendungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link modes are hidden: on macOS 14 and later, the links to the preference files break the settings of the applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modos de enlace están ocultos: en macOS 14 y posteriores, los enlaces a los archivos de preferencias rompen la configuración de las aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modes de lien sont masqués : sur macOS 14 et plus, les liens vers les fichiers de préférences cassent les réglages des applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modalità a collegamento sono nascoste: su macOS 14 e successivi i collegamenti ai file delle preferenze rompono le impostazioni delle applicazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクモードは隠されています。macOS 14 以降では、設定ファイルへのリンクがアプリの設定を壊してしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크 모드는 숨겨져 있습니다. macOS 14 이후에서는 설정 파일로의 링크가 앱의 설정을 망가뜨립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modos de link estão ocultos: no macOS 14 e posteriores, os links para os arquivos de preferências quebram as configurações dos aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы link спрятаны: на macOS 14 и новее симлинки на файлы настроек ломают настройки приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接模式已隐藏：在 macOS 14 及更高版本中，指向偏好设置文件的链接会破坏应用的设置。"
          }
        }
      }
    },
