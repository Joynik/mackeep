# Generated when running Mackeep
*.pyc

# Generated by make release and make binary
/dist/
/dist-bin/
/build/
/.build-venv/

# The Xcode project of the desktop application is generated
/desktop/MackeepDesktop.xcodeproj/
/desktop/build/
/desktop/*.profraw

# Coverage reports
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
.rumdl_cache/
.ruff_cache/

# Local verification logs and artifacts
/logs/
/artifacts/

# Published only on the library-index branch.
/library-manifest.json

# The local settings of the editor
/.vscode/

# Local audit report
/AUDIT.md

# Generated by graphify
/graphify-out/

# Agents settings
.agents
.codex
.claude
**/AGENTS.md

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
