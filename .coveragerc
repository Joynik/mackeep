[run]
source =
    src/mackeep
    src/mackeep_cli
branch = true
omit =
    */tests/*
    */__pycache__/*
    */.venv/*

[report]
fail_under = 90
precision = 2
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = htmlcov
